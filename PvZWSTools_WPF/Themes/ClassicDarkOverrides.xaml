<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        经典 UI 夜间覆写：零模板——只换颜色。
        控件几何/文字位置与 master 默认渲染完全一致（不使用任何自定义模板，
        不触碰 NewUI 资源）。窗口底色/文字由 UiThemeManager.RefreshWindowChrome 设置。
    -->

    <SolidColorBrush x:Key="CBg" Color="#1B1E24" />
    <SolidColorBrush x:Key="CCtl" Color="#2D2D30" />
    <SolidColorBrush x:Key="CHover" Color="#3E3E42" />
    <SolidColorBrush x:Key="CLine" Color="#55555A" />
    <SolidColorBrush x:Key="CFg" Color="#E8EAED" />

    <!--
        同一套语义键见 ClassicOverrides.xaml：经典模式下不定义的话，共享弹窗里的
        底色/文字/分隔线/红色提示会因 DynamicResource 悬空而整体失效（弹窗停在白底孤岛）。
        配色沿用本文件上面那五个值，不新造颜色。
        （别用 <StaticResource x:Key=... ResourceKey=.../> 做别名：能编译，运行时解析成
          DependencyProperty.UnsetValue，窗口一 Measure 就抛"不是 Foreground 的有效值"。）
    -->
    <SolidColorBrush x:Key="BgRootBrush" Color="#1B1E24" />
    <SolidColorBrush x:Key="BgPanelBrush" Color="#22262D" />
    <SolidColorBrush x:Key="BgControlBrush" Color="#2D2D30" />
    <SolidColorBrush x:Key="BorderLineBrush" Color="#55555A" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E8EAED" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A8ADB5" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF6B6B" />

    <!--  按钮：默认模板 + 深色  -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource CCtl}" />
        <Setter Property="Foreground" Value="{StaticResource CFg}" />
        <Setter Property="BorderBrush" Value="{StaticResource CLine}" />
    </Style>

    <!--  文本框：默认模板 + 深色（勾叉位置与 master 完全一致）  -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource CCtl}" />
        <Setter Property="Foreground" Value="{StaticResource CFg}" />
        <Setter Property="BorderBrush" Value="{StaticResource CLine}" />
        <Setter Property="CaretBrush" Value="{StaticResource CFg}" />
        <Setter Property="SelectionBrush" Value="{StaticResource CLine}" />
    </Style>

    <!--  标签页：最小深色模板（内容摆放与 master 默认一致，仅外壳换深色）  -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{StaticResource CBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource CLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource CFg}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TabPanel Margin="2,2,2,0" IsItemsHost="True" />
                        <Border
                            Grid.Row="1"
                            Margin="0,-1,0,0"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1">
                            <ContentPresenter ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource CFg}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border
                        x:Name="Bd"
                        Margin="0,0,2,0"
                        Background="{StaticResource CCtl}"
                        BorderBrush="{StaticResource CLine}"
                        BorderThickness="1,1,1,0"
                        CornerRadius="3,3,0,0"
                        Padding="9,4"
                        SnapsToDevicePixels="True">
                        <ContentPresenter
                            ContentSource="Header"
                            RecognizesAccessKey="True"
                            VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CBg}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1,1,1,0" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CHover}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  列表  -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource CBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource CLine}" />
        <Setter Property="Foreground" Value="{StaticResource CFg}" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource CFg}" />
    </Style>

    <!--  下拉框  -->
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource CCtl}" />
        <Setter Property="Foreground" Value="{StaticResource CFg}" />
        <Setter Property="BorderBrush" Value="{StaticResource CLine}" />
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource CFg}" />
    </Style>

    <!--  工具提示  -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource CCtl}" />
        <Setter Property="Foreground" Value="{StaticResource CFg}" />
        <Setter Property="BorderBrush" Value="{StaticResource CLine}" />
    </Style>

</ResourceDictionary>
