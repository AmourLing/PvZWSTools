<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PvZWSTools</AssemblyName>
    <Configurations>Debug;Release</Configurations>
    <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
    <PackageIcon>icon.png</PackageIcon>
    <StartupObject>PvZWSTools_WPF.Program</StartupObject>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <OutputType>Exe</OutputType>
    <UseWindowsForms>false</UseWindowsForms>
    <Version>2026.9.2</Version>
    <InformationalVersion>2026.09.02</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="WebSocketSharp.NetCore" Version="1.0.1-alpha.4" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\readme.md" />
    <None Include="Resources\icon.png" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="$(SolutionDir)配置文件\**\*" Link="配置文件\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="Always" />
    <Content Include="$(SolutionDir)readme.md" CopyToOutputDirectory="Always" />
    <Content Include="Resources\icon.ico" CopyToOutputDirectory="Always" />
    <Content Include="Resources\Background_Main.png" Condition="'$(Configuration)' == 'Debug'" CopyToOutputDirectory="Always" />
    <Content Include="Resources\Background_Night.png" Condition="'$(Configuration)' == 'Debug'" CopyToOutputDirectory="Always" />
    <Content Include="Resources\Background_Mushroom.png" Condition="'$(Configuration)' == 'Debug'" CopyToOutputDirectory="Always" />
    <Content Include="Resources\Background_Aquarium.png" Condition="'$(Configuration)' == 'Debug'" CopyToOutputDirectory="Always" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadata">
      <_Parameter1>BuildTimestamp</_Parameter1>
      <_Parameter2>$([System.DateTime]::UtcNow.ToString("o"))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <Import Project="..\PvZWSTools_Shared\PvZWSTools_Shared.projitems" Label="Shared" />
</Project>