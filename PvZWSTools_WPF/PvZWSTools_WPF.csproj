<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PvZWSTools</AssemblyName>
    <Configurations>Debug;Release</Configurations>
    <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
    <PackageIcon>icon.png</PackageIcon>
    <StartupObject>PvZWSTools_WPF.Program</StartupObject>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <!--  两个入口一次编出来：PvZWSTools.exe 固定 WinExe（不给玩家多挂一个黑窗口），
          控制台那一版另出 PvZWSTools.Console.exe（见下面的 CreateConsoleAppHost*）。
          以前是 Debug=Exe / Release=WinExe 靠配置切，现在两个配置都同时有两条入口，
          名字不再随配置变语义——F5 想看日志就跑 Console 那个。
          F5 走 Properties\launchSettings.json，那里的 executablePath 必须带 .\ 前缀：
          VS 只给"带目录部分"的相对路径拼输出目录（实测基准就是 bin\Debug\net10.0-windows\，
          写成 bin\Debug\... 会拼成两层，光写文件名它当程序名去搜），而 dotnet run 按调用目录解析，
          两边凑不到一块儿，以 VS 为准。
          没有控制台时 Console.ForegroundColor / Console.Title 会抛，相关调用点都已收口。  -->
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>false</UseWindowsForms>
    <Version>2026.10.4</Version>
    <InformationalVersion>2026.10.04</InformationalVersion>
    <SolutionDir Condition="'$(SolutionDir)' == '' Or '$(SolutionDir)' == '*Undefined*'">$(MSBuildThisFileDirectory)..\</SolutionDir>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="WebSocketSharp.NetCore" Version="1.0.1-alpha.4" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\readme.md" />
    <None Include="Resources\icon.png" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="$(SolutionDir)配置文件\**\*" Link="配置文件\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="Always" />
    <Content Include="$(SolutionDir)readme.md" CopyToOutputDirectory="Always" />
    <!--  许可声明要随产物走：MIT 与依赖们的许可证都写着"副本中须包含本声明"，而安装器
          和 zip 打包的都是这个输出目录，不放进来用户拿到的东西里就没有任何许可信息。
          THIRD-PARTY-NOTICES.md 列的是第三方依赖的授权，不是本工程自己的 MIT；
          它由 文档\_build\gen_notices.py 从依赖解析结果生成，别手改。 -->
    <Content Include="$(SolutionDir)LICENSE" CopyToOutputDirectory="Always" />
    <Content Include="$(SolutionDir)THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="Always" />
    <!--  运行时自带的第三方清单太长（Windows 78 KB / Android 145 KB），汇总文本覆盖不了，
          逐字副本单独放 licenses\ 随包走。点名 *.txt 而不是整目录通配，是为了以后往这个
          目录放别的东西时不会被顺手打进安装包。 -->
    <Content Include="$(SolutionDir)licenses\*.txt" Link="licenses\%(Filename)%(Extension)" CopyToOutputDirectory="Always" />
    <Content Include="Resources\icon.ico" CopyToOutputDirectory="Always" />
    <!--  花园页背景，格位坐标与图同一套像素，换算见 PvZWSTools_Shared\UiModel\GardenLayout.cs。
          这四张是从游戏 Content/images 的 xnb 解包转出来的，著作权在 PopCap/EA，不能进仓库，
          已在 .gitignore 里忽略，只留在本机。必须是 Resource 而不是随目录走的 Content ——
          界面里的 Image 用的是 pack URI，松散文件不会被这个 URI 找到。
          进不进程序集看 HasGarden（仓库根 Directory.Build.props），和 Sharedstring.HasGarden
          管的那个导航入口同源：默认 Debug 有、Release 没有。发布包因此不含这些图，
          谁要自己出带花园的包，得自备素材并接受那部分是别人的版权。 -->
    <Resource Include="Resources\garden\*.jpg" Condition="'$(HasGarden)' == 'true'" />
  </ItemGroup>
  <!--  那四张背景图不入库（著作权在 PopCap/EA），所以 glob 在别的机器上会收到 0 个文件，
        而 HasGarden=true 照样把导航入口打开 —— 出一个「有花园页、点进去背景全空」的包，
        且一声不响。这里把它变成硬失败。数 4 而不是判 Exists 单个文件，是因为少哪张都是
        少一张空背景，不会另报错。 -->
  <Target Name="GuardGardenBackdrops" BeforeTargets="BeforeBuild" Condition="'$(HasGarden)' == 'true'">
    <ItemGroup>
      <_GardenBackdrop Include="Resources\garden\*.jpg" />
    </ItemGroup>
    <PropertyGroup>
      <_GardenBackdropCount>@(_GardenBackdrop->Count())</_GardenBackdropCount>
    </PropertyGroup>
    <Error Condition="'$(_GardenBackdropCount)' != '4'"
           Text="HasGarden=true，但 Resources\garden 下只数到 $(_GardenBackdropCount) 张背景图（应为 4 张）。这四张是游戏解包件、不在仓库里，构建机上必须自备；不要改成 false 蒙过去，那样出来的包导航里有花园、点进去背景全空。" />
  </Target>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadata">
      <_Parameter1>BuildTimestamp</_Parameter1>
      <_Parameter2>$([System.DateTime]::UtcNow.ToString("o"))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
      ============================================================
                        控制台入口 PvZWSTools.Console.exe
      ============================================================
      两个 exe 的差别只有 apphost 的 PE 子系统那一位（GUI=2 / 控制台=3）：托管程序集仍是
      PvZWSTools.dll，宿主按文件内嵌的那个名字去找 dll 与 runtimeconfig/deps，所以第二个入口
      不需要第二份 dll、不需要同名 json，跟主程序共用同一套文件。
      做法是复用 SDK 自己的 CreateAppHost 任务（_CreateAppHost 用的就是它），把
      WindowsGraphicalUserInterface 传成 false 再出一个 apphost。不去手工翻 PE 头字节：
      那个任务还管图标、CET 兼容标记、macOS 签名这些，手改只补了子系统，别的会一样样漏。
      -p:GenerateConsoleAppHost=false 可以整个跳过（TcpTableProbe 那类引用本工程的小工具用不上）。
  -->
  <PropertyGroup>
    <ConsoleAssemblyName>PvZWSTools.Console</ConsoleAssemblyName>
  </PropertyGroup>

  <!--  build 产出落 bin\。两条写在这里而不是抽成公共目标用 CallTarget 调：实测（SDK 10.0.401）
        CallTarget 进去的子目标看不到调用方在运行时设的属性，路径递不进去，只会拿到空值。
        判定放在目标跑起来之后，不在 Target 的 Condition 里判 $(AppHostSourcePath)——目标条件先于
        DependsOnTargets 求值，那时 _GetAppHostPaths 还没跑、属性还是空的，写在条件上等于每次都跳过。
        跳过必须出声：闷着出一个少了控制台入口的包，比编不过更难查。 -->
  <Target Name="CreateConsoleAppHost" AfterTargets="Build" DependsOnTargets="_GetAppHostPaths">
    <PropertyGroup>
      <_ConsoleTargetDir>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(TargetDir)'))</_ConsoleTargetDir>
      <ConsoleAppHostDestination>$([System.IO.Path]::Combine('$(_ConsoleTargetDir)', '$(ConsoleAssemblyName).exe'))</ConsoleAppHostDestination>
      <_ConsoleAppHostDisabled Condition="'$(GenerateConsoleAppHost)' == 'false'">true</_ConsoleAppHostDisabled>
      <_ConsoleAppHostBlocked Condition="'$(_ConsoleAppHostDisabled)' != 'true' and
                                         ('$(UseAppHost)' != 'true' or '$(AppHostSourcePath)' == '' or !Exists('$(AppHostSourcePath)'))">true</_ConsoleAppHostBlocked>
    </PropertyGroup>
    <!--  主动关掉的（-p:GenerateConsoleAppHost=false）不该吃一条警告：那是他点名的行为。
        只有"想生成却没生成成"才出声。 -->
    <Message Condition="'$(_ConsoleAppHostDisabled)' == 'true'" Importance="low"
             Text="控制台入口按 -p:GenerateConsoleAppHost=false 跳过。" />
    <Warning Condition="'$(_ConsoleAppHostBlocked)' == 'true'"
             Text="控制台入口没生成（AppHostSourcePath='$(AppHostSourcePath)'、UseAppHost='$(UseAppHost)'）。主程序 exe 出得来就说明 apphost 模板没就位，查 SDK / apphost pack 的安装。" />
    <CreateAppHost Condition="'$(_ConsoleAppHostBlocked)' != 'true' and '$(_ConsoleAppHostDisabled)' != 'true'"
                   AppHostSourcePath="$(AppHostSourcePath)"
                   AppHostDestinationPath="$(ConsoleAppHostDestination)"
                   AppBinaryName="$(AssemblyName)$(TargetExt)"
                   IntermediateAssembly="@(IntermediateAssembly->'%(FullPath)')"
                   WindowsGraphicalUserInterface="false"
                   Retries="$(CopyRetryCount)"
                   RetryDelayMilliseconds="$(CopyRetryDelayMilliseconds)" />
    <Message Condition="'$(_ConsoleAppHostBlocked)' != 'true' and '$(_ConsoleAppHostDisabled)' != 'true'"
             Importance="high" Text="控制台入口已生成：$(ConsoleAppHostDestination)" />
  </Target>

  <!--  发布目录里的第二份入口：publish 只搬它自己认识的产出组，我们自己产的 exe 不在里面，
        所以从 bin\ 把刚生成的那个 apphost 复制过去（同一份字节，不再走一遍 CreateAppHost）。
        少了这一步就是"本机 bin\ 有、发出去的包里没有"，那种问题最难查，所以源文件不在直接失败，
        不降级成警告。 -->
  <Target Name="CopyConsoleAppHostToPublish" AfterTargets="Publish">
    <PropertyGroup>
      <_ConsoleSource>$([System.IO.Path]::Combine($([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(TargetDir)')), '$(ConsoleAssemblyName).exe'))</_ConsoleSource>
      <_ConsolePublishDir>$([MSBuild]::EnsureTrailingSlash($([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(PublishDir)'))))</_ConsolePublishDir>
    </PropertyGroup>
    <Error Condition="'$(GenerateConsoleAppHost)' != 'false' and !Exists('$(_ConsoleSource)')"
           Text="拿不到控制台入口源文件：$(_ConsoleSource)。build 那趟的 CreateConsoleAppHost 没出东西，看上面有没有那条警告。" />
    <Copy Condition="'$(GenerateConsoleAppHost)' != 'false'" SourceFiles="$(_ConsoleSource)"
          DestinationFolder="$(_ConsolePublishDir)" SkipUnchangedFiles="true" />
    <Message Condition="'$(GenerateConsoleAppHost)' != 'false'" Importance="high"
             Text="控制台入口已随发布复制：$(_ConsolePublishDir)$(ConsoleAssemblyName).exe" />
  </Target>

  <!-- 发布布局：根目录留两个入口 exe（无控制台的 + 带控制台的），其余文件收进 app\。
       做在工程里而不是只做在 build-release.ps1 里，是为了让 VS 的"发布"向导走同一条路。
       入口用 Framework 自带的 csc 编，产物只依赖 .NET Framework 4，用户机器无需装运行时。
       -p:StageNestedPublishLayout=false 可以跳过。 -->
  <PropertyGroup>
    <LauncherSource>$(MSBuildProjectDirectory)\..\PvZWSTools_WpfLauncher\Launcher.cs</LauncherSource>
    <!-- 入口源码单独放 PvZWSTools_WpfLauncher\，不在本工程目录里：SDK 工程会把 **\*.cs 全 glob 进编译，
         那个文件里有自己的 Main，混进来就是重复入口。生成物也不能落本工程 obj\：WPF 的 _wpftmp
         临时工程会把 obj 下的 .cs 当源码收进去，造成 AssemblyTitle 等特性重复。
         这条只服务 Windows 的发布布局，和安卓那条线无关，所以名字里写清是 WPF 的。 -->
    <LauncherDir>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '..', 'PvZWSTools_WpfLauncher', 'obj'))</LauncherDir>
    <LauncherInfoFile>$(LauncherDir)\AssemblyInfo.cs</LauncherInfoFile>
    <LauncherExe>$(LauncherDir)\PvZWSTools.exe</LauncherExe>
    <LauncherConsoleExe>$(LauncherDir)\PvZWSTools.Console.exe</LauncherConsoleExe>
    <FrameworkCsc>$([MSBuild]::NormalizePath($([System.Environment]::GetEnvironmentVariable('WINDIR')), 'Microsoft.NET\Framework64\v4.0.30319\csc.exe'))</FrameworkCsc>
  </PropertyGroup>

  <Target Name="StageNestedPublishLayout" AfterTargets="Publish"
          DependsOnTargets="CopyConsoleAppHostToPublish"
          Condition="'$(StageNestedPublishLayout)' != 'false'">
    <Error Condition="!Exists('$(LauncherSource)')" Text="缺少入口源码：$(LauncherSource)" />
    <Error Condition="!Exists('$(FrameworkCsc)')" Text="缺少 .NET Framework csc：$(FrameworkCsc)" />

    <PropertyGroup>
      <_PubDir>$([MSBuild]::EnsureTrailingSlash($([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(PublishDir)'))))</_PubDir>
      <_PubAppDir>$([MSBuild]::NormalizePath($(_PubDir), 'app'))\</_PubAppDir>
    </PropertyGroup>

    <MakeDir Directories="$(LauncherDir)" />
    <!-- 单行分号分隔：MSBuild 按 ; 切成 6 行写文件；写成多行会把行尾分号带进 C# 源码 -->
    <WriteLinesToFile File="$(LauncherInfoFile)" Overwrite="true"
      Lines='[assembly: System.Reflection.AssemblyTitle("PvZWSTools")];[assembly: System.Reflection.AssemblyProduct("PvZWSTools")];[assembly: System.Reflection.AssemblyCompany("AmourLing")];[assembly: System.Reflection.AssemblyVersion("$(Version).0")];[assembly: System.Reflection.AssemblyFileVersion("$(Version).0")];[assembly: System.Reflection.AssemblyInformationalVersion("$(InformationalVersion)")]' />
    <Exec Command="&quot;$(FrameworkCsc)&quot; -nologo -target:winexe -out:&quot;$(LauncherExe)&quot; -win32icon:&quot;$(MSBuildProjectDirectory)\Resources\icon.ico&quot; -r:System.Windows.Forms.dll &quot;$(LauncherSource)&quot; &quot;$(LauncherInfoFile)&quot;" />
    <!--  第二份：-target:exe 出控制台子系统，-define:CONSOLE_LAUNCHER 让它拉的是
          app\PvZWSTools.Console.exe。这两条必须成对改——只改 -target 不改 define，
          根上那个"控制台入口"起的是没控制台的那份，从图标和名字上都看不出来。 -->
    <Exec Command="&quot;$(FrameworkCsc)&quot; -nologo -target:exe -define:CONSOLE_LAUNCHER -out:&quot;$(LauncherConsoleExe)&quot; -win32icon:&quot;$(MSBuildProjectDirectory)\Resources\icon.ico&quot; -r:System.Windows.Forms.dll &quot;$(LauncherSource)&quot; &quot;$(LauncherInfoFile)&quot;" />

    <MakeDir Directories="$(_PubAppDir)" />
    <!-- Copy+Delete 只会删文件，会把 Resources\配置文件 这些空目录骨架留在根上；
         robocopy /MOVE 连目录一起搬走。robocopy 的 0-7 都是正常码，所以不拿退出码判断，
         改看结构：主程序 dll 必须已经进 app\，且根上不能再有它。 -->
    <Exec Command="robocopy &quot;$(_PubDir.TrimEnd('\'))&quot; &quot;$(_PubAppDir.TrimEnd('\'))&quot; /E /MOVE /XD &quot;$(_PubAppDir.TrimEnd('\'))&quot; /NFL /NDL /NJH /NJS /NP"
          IgnoreExitCode="true" />
    <Error Condition="!Exists('$(_PubAppDir)PvZWSTools.dll')" Text="发布文件没有移进 $(_PubAppDir)" />
    <Error Condition="Exists('$(_PubDir)PvZWSTools.dll')" Text="$(_PubDir) 根上还留着主程序，app\ 重排没干净" />
    <!--  内层控制台入口是 CopyConsoleAppHostToPublish 那份，跟着 robocopy 进 app\；
          外层两份是上面 csc 刚编出来的。少哪一份都要硬失败，别出"根上看得见控制台入口、
          点进去起的是没控制台那份"这种包。 -->
    <Error Condition="!Exists('$(_PubAppDir)PvZWSTools.Console.exe')"
           Text="$(_PubAppDir) 里没有内层控制台入口 PvZWSTools.Console.exe，控制台那条线在发布包里断了" />
    <Copy SourceFiles="$(LauncherExe);$(LauncherConsoleExe)" DestinationFolder="$(_PubDir)" />
    <Error Condition="!Exists('$(_PubDir)PvZWSTools.exe') Or !Exists('$(_PubDir)PvZWSTools.Console.exe')"
           Text="$(_PubDir) 根上凑不齐两个入口 exe（PvZWSTools.exe / PvZWSTools.Console.exe）" />

    <Message Importance="high" Text="发布布局已重排：$(_PubDir) 只剩两个入口 exe 与 app\（$([System.IO.Directory]::GetFiles($(_PubAppDir), '*', System.IO.SearchOption.AllDirectories).Length) 个文件）" />
  </Target>

  <Import Project="..\PvZWSTools_Shared\PvZWSTools_Shared.projitems" Label="Shared" />
</Project>