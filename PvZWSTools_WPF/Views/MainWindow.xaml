<Window
    x:Class="PvZWSTools_WPF.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:PvZWSTools_WPF.Models"
    xmlns:viewModels="clr-namespace:PvZWSTools_WPF.ViewModels"
    Title="PvZWSTools_Windows"
    Width="{Binding CurrentWidth, Mode=TwoWay}"
    Height="600"
    Icon="../Resources/icon.ico"
    SizeChanged="Window_SizeChanged"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock
                            Margin="5"
                            FontSize="14"
                            Text="{Binding}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Margin" Value="5" />
        </Style>
    </Window.Resources>

    <Viewbox Stretch="Fill" StretchDirection="Both">
        <Border Width="640" Height="400">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  WebSocket 地址栏  -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="wsAddrInput"
                        Grid.Column="0"
                        Height="25"
                        FontSize="16"
                        Text="{Binding WsAddress, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Column="1"
                        Width="50"
                        Command="{Binding ConnectCommand}"
                        Content="{Binding ConnectionButtonText}" />
                </Grid>

                <!--  主选项卡  -->
                <Grid Grid.Row="1">
                    <TabControl x:Name="MainTabControl">
                        <!--  杂项  -->
                        <TabItem Header="杂项">
                            <Grid DataContext="{Binding Others}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="35" />
                                    <RowDefinition Height="35" />
                                    <RowDefinition Height="35" />
                                    <RowDefinition Height="35" />
                                    <RowDefinition Height="35" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="89" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="29" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="29" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="29" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>

                                <!--  更新按钮状态  -->
                                <Button
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Width="90"
                                    Height="25"
                                    Command="{Binding UpdateButtonStatusCommand}"
                                    Content="更新按钮状态" />

                                <!--  智慧树高度  -->
                                <TextBox
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Width="90"
                                    Height="25"
                                    FontSize="16"
                                    Text="{Binding SetTreeHeight}" />
                                <Button
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Width="90"
                                    Height="25"
                                    Command="{Binding SetTreeHeightCommand}"
                                    Content="设置树的高度" />

                                <!--  清除浓雾  -->
                                <TextBox
                                    Grid.Row="0"
                                    Grid.Column="3"
                                    Width="30"
                                    Height="25"
                                    FontSize="16"
                                    IsReadOnly="True"
                                    Text="{Binding ClearFog}" />
                                <Button
                                    Grid.Row="0"
                                    Grid.Column="4"
                                    Width="90"
                                    Height="25"
                                    Command="{Binding ClearFogCommand}"
                                    Content="清除浓雾" />

                                <!--  透明花瓶  -->
                                <TextBox
                                    Grid.Row="1"
                                    Grid.Column="3"
                                    Width="30"
                                    Height="25"
                                    FontSize="16"
                                    IsReadOnly="True"
                                    Text="{Binding ClearVase}" />
                                <Button
                                    Grid.Row="1"
                                    Grid.Column="4"
                                    Width="90"
                                    Height="25"
                                    Command="{Binding ClearVaseCommand}"
                                    Content="透明花瓶" />

                                <!--  阳光增值  -->
                                <TextBox
                                    Grid.Row="2"
                                    Grid.Column="3"
                                    Width="30"
                                    Height="25"
                                    FontSize="16"
                                    IsReadOnly="True"
                                    Text="{Binding BigSun}" />
                                <Button
                                    Grid.Row="2"
                                    Grid.Column="4"
                                    Width="90"
                                    Height="25"
                                    Command="{Binding BigSunCommand}"
                                    Content="阳光增值" />

                                <!--  自动收集  -->
                                <TextBox
                                    Grid.Row="0"
                                    Grid.Column="6"
                                    Width="30"
                                    Height="25"
                                    FontSize="16"
                                    IsReadOnly="True"
                                    Text="{Binding AutoCollect}" />
                                <Button
                                    Grid.Row="0"
                                    Grid.Column="7"
                                    Width="90"
                                    Height="25"
                                    Command="{Binding AutoCollectCommand}"
                                    Content="自动收集" />

                                <!--  无冷却种植  -->
                                <TextBox
                                    Grid.Row="1"
                                    Grid.Column="6"
                                    Width="30"
                                    Height="25"
                                    FontSize="16"
                                    IsReadOnly="True"
                                    Text="{Binding NoCDPlanting}" />
                                <Button
                                    Grid.Row="1"
                                    Grid.Column="7"
                                    Width="90"
                                    Height="25"
                                    Command="{Binding NoCDPlantingCommand}"
                                    Content="无冷却种植" />

                                <!--  自动浇水  -->
                                <TextBox
                                    Grid.Row="2"
                                    Grid.Column="6"
                                    Width="30"
                                    Height="25"
                                    FontSize="16"
                                    IsReadOnly="True"
                                    Text="{Binding AutoWatering}" />
                                <Button
                                    Grid.Row="2"
                                    Grid.Column="7"
                                    Width="90"
                                    Height="25"
                                    Command="{Binding AutoWateringCommand}"
                                    Content="自动浇水" />

                                <!--  0花费种植  -->
                                <TextBox
                                    Grid.Row="0"
                                    Grid.Column="9"
                                    Width="30"
                                    Height="25"
                                    FontSize="16"
                                    IsReadOnly="True"
                                    Text="{Binding NoCostPlanting}" />
                                <Button
                                    Grid.Row="0"
                                    Grid.Column="10"
                                    Width="90"
                                    Height="25"
                                    Command="{Binding NoCostPlantingCommand}"
                                    Content="0花费种植" />

                                <!--  后台运行  -->
                                <TextBox
                                    Grid.Row="1"
                                    Grid.Column="9"
                                    Width="30"
                                    Height="25"
                                    FontSize="16"
                                    IsReadOnly="True"
                                    Text="{Binding RunWhileLocked}" />
                                <Button
                                    Grid.Row="1"
                                    Grid.Column="10"
                                    Width="90"
                                    Height="25"
                                    Command="{Binding RunWhileLockedCommand}"
                                    Content="后台运行" />
                            </Grid>
                        </TabItem>

                        <!--  关卡  -->
                        <TabItem Header="关卡">
                            <Grid DataContext="{Binding Level}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="35" />
                                    <RowDefinition Height="35" />
                                    <RowDefinition Height="35" />
                                    <RowDefinition Height="35" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="350" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>

                                <!--  设置模式  -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="165" />
                                        <ColumnDefinition Width="25" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        Grid.Column="0"
                                        Height="25"
                                        FontSize="16"
                                        IsReadOnly="True"
                                        Text="{Binding ModeInput}" />
                                    <ToggleButton
                                        x:Name="ModeDropdownToggle"
                                        Grid.Column="1"
                                        Width="25"
                                        Height="25"
                                        Content="🔻"
                                        IsChecked="{Binding ModeDropdownToggleIsChecked, Mode=TwoWay}" />
                                    <TextBox
                                        Grid.Column="2"
                                        Width="71"
                                        Height="25"
                                        FontSize="16"
                                        Text="{Binding AdventureInput}" />
                                    <Button
                                        x:Name="SetModeBtn"
                                        Grid.Column="3"
                                        Height="25"
                                        Command="{Binding SetModeCommand}"
                                        Content="混乱关卡" />
                                    <Popup
                                        IsOpen="{Binding ModeDropdownToggleIsChecked, Mode=TwoWay}"
                                        Placement="Bottom"
                                        PlacementTarget="{Binding ElementName=ModeDropdownToggle}"
                                        StaysOpen="False">
                                        <Border
                                            Background="White"
                                            BorderBrush="Gray"
                                            BorderThickness="1">
                                            <ListBox
                                                x:Name="ModeListBox"
                                                MaxHeight="150"
                                                DisplayMemberPath="DisplayName"
                                                ItemsSource="{Binding ModeOptions}"
                                                SelectedItem="{Binding ModeSelected}" />
                                        </Border>
                                    </Popup>
                                </Grid>

                                <!--  无尽旗数  -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="165" />
                                        <ColumnDefinition Width="25" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="EndlessFlagInput"
                                        Grid.Column="2"
                                        Width="100"
                                        Height="25"
                                        FontSize="16"
                                        Text="{Binding EndlessFlag}" />
                                    <Button
                                        x:Name="SetEndlessFlagBtn"
                                        Grid.Column="3"
                                        Width="90"
                                        Height="25"
                                        Command="{Binding SetEndlessFlagCommand}"
                                        Content="设置无尽旗数" />
                                </Grid>

                                <!--  EnterNewLevel  -->
                                <Button
                                    x:Name="EnterNewLevelBtn"
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Width="90"
                                    Height="25"
                                    Command="{Binding EnterNewLevelCommand}"
                                    Content="EnterNewLevel" />

                                <!--  直接过关  -->
                                <Button
                                    x:Name="PassThisLevelBtn"
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    Width="90"
                                    Height="25"
                                    Command="{Binding PassThisLevelCommand}"
                                    Content="直接过关" />
                            </Grid>
                        </TabItem>

                        <!--  资源  -->
                        <TabItem Header="资源">
                            <Grid DataContext="{Binding Resources}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="50" />
                                    <RowDefinition Height="50" />
                                    <RowDefinition Height="50" />
                                    <RowDefinition Height="50" />
                                    <RowDefinition Height="50" />
                                    <RowDefinition Height="50" />
                                </Grid.RowDefinitions>

                                <!--  阳光  -->
                                <TextBlock
                                    Grid.Row="0"
                                    Margin="0,0,0,0"
                                    FontSize="20"
                                    Text="阳光" />
                                <TextBox
                                    Grid.Row="0"
                                    Width="100"
                                    Height="30"
                                    Margin="50,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    FontSize="20"
                                    Text="{Binding SunCount}" />
                                <Button
                                    Grid.Row="0"
                                    Width="80"
                                    Height="30"
                                    Margin="160,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Command="{Binding SunSetCommand}"
                                    Content="设置阳光" />

                                <!--  阳光上限  -->
                                <TextBlock
                                    Grid.Row="0"
                                    Margin="270,0,0,0"
                                    FontSize="20"
                                    Text="阳光上限" />
                                <TextBox
                                    Grid.Row="0"
                                    Width="100"
                                    Height="30"
                                    Margin="360,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    FontSize="20"
                                    Text="{Binding SunCountLimit}" />
                                <Button
                                    Grid.Row="0"
                                    Width="80"
                                    Height="30"
                                    Margin="470,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Command="{Binding SunLimitSetCommand}"
                                    Content="设置阳光上限" />

                                <!--  金钱  -->
                                <TextBlock
                                    Grid.Row="1"
                                    Margin="0,0,0,0"
                                    FontSize="20"
                                    Text="金钱" />
                                <TextBox
                                    Grid.Row="1"
                                    Width="100"
                                    Height="30"
                                    Margin="50,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    FontSize="20"
                                    Text="{Binding MoneyCount}" />
                                <Button
                                    Grid.Row="1"
                                    Width="80"
                                    Height="30"
                                    Margin="160,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Command="{Binding MoneySetCommand}"
                                    Content="设置金钱" />

                                <!--  金钱上限  -->
                                <TextBlock
                                    Grid.Row="1"
                                    Margin="270,0,0,0"
                                    FontSize="20"
                                    Text="金钱上限" />
                                <TextBox
                                    Grid.Row="1"
                                    Width="100"
                                    Height="30"
                                    Margin="360,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    FontSize="20"
                                    Text="{Binding MoneyCountLimit}" />
                                <Button
                                    Grid.Row="1"
                                    Width="80"
                                    Height="30"
                                    Margin="470,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Command="{Binding MoneyLimitSetCommand}"
                                    Content="设置金钱上限" />

                                <!--  价值  -->
                                <Grid
                                    Grid.Row="2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="25" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        FontSize="20"
                                        Text="价值" />
                                    <TextBox
                                        Grid.Column="1"
                                        Height="25"
                                        VerticalAlignment="Top"
                                        FontSize="16"
                                        Text="{Binding ValueInput}" />
                                    <ToggleButton
                                        x:Name="ValueDropdownToggle"
                                        Grid.Column="2"
                                        Width="25"
                                        Height="25"
                                        VerticalAlignment="Top"
                                        Content="🔻"
                                        IsChecked="{Binding ValueDropdownToggleIsChecked, Mode=TwoWay}" />
                                    <TextBox
                                        x:Name="ValueInput2"
                                        Grid.Column="3"
                                        Height="25"
                                        VerticalAlignment="Top"
                                        FontSize="16"
                                        Text="{Binding ValueInput2}" />
                                    <Button
                                        Grid.Column="4"
                                        Height="25"
                                        VerticalAlignment="Top"
                                        Command="{Binding ValueSetCommand}"
                                        Content="设置价值" />
                                    <Popup
                                        IsOpen="{Binding ValueDropdownToggleIsChecked, Mode=TwoWay}"
                                        Placement="Bottom"
                                        PlacementTarget="{Binding ElementName=ValueDropdownToggle}"
                                        StaysOpen="False">
                                        <Border
                                            Background="White"
                                            BorderBrush="Gray"
                                            BorderThickness="1">
                                            <ListBox
                                                x:Name="ValueListBox"
                                                MaxHeight="150"
                                                DisplayMemberPath="DisplayName"
                                                ItemsSource="{Binding ValueOptions}"
                                                SelectedItem="{Binding ValueSelected}" />
                                        </Border>
                                    </Popup>
                                </Grid>

                                <!--  伤害  -->
                                <Grid
                                    Grid.Row="3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="25" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        FontSize="20"
                                        Text="伤害" />
                                    <TextBox
                                        x:Name="DamageInput"
                                        Grid.Column="1"
                                        Height="25"
                                        VerticalAlignment="Top"
                                        FontSize="16"
                                        Text="{Binding DamageInput}" />
                                    <ToggleButton
                                        x:Name="DamageDropdownToggle"
                                        Grid.Column="2"
                                        Width="25"
                                        Height="25"
                                        VerticalAlignment="Top"
                                        Content="🔻"
                                        IsChecked="{Binding DamageDropdownToggleIsChecked, Mode=TwoWay}" />
                                    <TextBox
                                        x:Name="DamageInput2"
                                        Grid.Column="3"
                                        Height="25"
                                        VerticalAlignment="Top"
                                        FontSize="16"
                                        Text="{Binding DamageInput2}" />
                                    <Button
                                        Grid.Column="4"
                                        Height="25"
                                        VerticalAlignment="Top"
                                        Command="{Binding DamageSetCommand}"
                                        Content="设置伤害" />
                                    <Popup
                                        IsOpen="{Binding DamageDropdownToggleIsChecked, Mode=TwoWay}"
                                        Placement="Bottom"
                                        PlacementTarget="{Binding ElementName=DamageDropdownToggle}"
                                        StaysOpen="False">
                                        <Border
                                            Background="White"
                                            BorderBrush="Gray"
                                            BorderThickness="1">
                                            <ListBox
                                                x:Name="DamageListBox"
                                                MaxHeight="150"
                                                DisplayMemberPath="DisplayName"
                                                ItemsSource="{Binding DamageOptions}"
                                                SelectedItem="{Binding DamageSelected}" />
                                        </Border>
                                    </Popup>
                                </Grid>

                                <!--  血量  -->
                                <Grid
                                    Grid.Row="4"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="25" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        FontSize="20"
                                        Text="血量" />
                                    <TextBox
                                        x:Name="HealthInput"
                                        Grid.Column="1"
                                        Height="25"
                                        VerticalAlignment="Top"
                                        FontSize="16"
                                        Text="{Binding HealthInput}" />
                                    <ToggleButton
                                        x:Name="HealthDropdownToggle"
                                        Grid.Column="2"
                                        Width="25"
                                        Height="25"
                                        VerticalAlignment="Top"
                                        Content="🔻"
                                        IsChecked="{Binding HealthDropdownToggleIsChecked, Mode=TwoWay}" />
                                    <TextBox
                                        x:Name="HealthInput2"
                                        Grid.Column="3"
                                        Height="25"
                                        VerticalAlignment="Top"
                                        FontSize="16"
                                        Text="{Binding HealthInput2}" />
                                    <Button
                                        Grid.Column="4"
                                        Height="25"
                                        VerticalAlignment="Top"
                                        Command="{Binding HealthSetCommand}"
                                        Content="设置血量" />
                                    <Popup
                                        IsOpen="{Binding HealthDropdownToggleIsChecked, Mode=TwoWay}"
                                        Placement="Bottom"
                                        PlacementTarget="{Binding ElementName=HealthDropdownToggle}"
                                        StaysOpen="False">
                                        <Border
                                            Background="White"
                                            BorderBrush="Gray"
                                            BorderThickness="1">
                                            <ListBox
                                                x:Name="HealthListBox"
                                                MaxHeight="150"
                                                DisplayMemberPath="DisplayName"
                                                ItemsSource="{Binding HealthOptions}"
                                                SelectedItem="{Binding HealthSelected}" />
                                        </Border>
                                    </Popup>
                                </Grid>

                                <!--  时间  -->
                                <Grid
                                    Grid.Row="5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="25" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        FontSize="20"
                                        Text="时间" />
                                    <TextBox
                                        x:Name="TimeInput"
                                        Grid.Column="1"
                                        Height="25"
                                        VerticalAlignment="Top"
                                        FontSize="16"
                                        Text="{Binding TimeInput}" />
                                    <ToggleButton
                                        x:Name="TimeDropdownToggle"
                                        Grid.Column="2"
                                        Width="25"
                                        Height="25"
                                        VerticalAlignment="Top"
                                        Content="🔻"
                                        IsChecked="{Binding TimeDropdownToggleIsChecked, Mode=TwoWay}" />
                                    <TextBox
                                        x:Name="TimeInput2"
                                        Grid.Column="3"
                                        Height="25"
                                        VerticalAlignment="Top"
                                        FontSize="16"
                                        Text="{Binding TimeInput2}" />
                                    <Button
                                        Grid.Column="4"
                                        Height="25"
                                        VerticalAlignment="Top"
                                        Command="{Binding TimeSetCommand}"
                                        Content="设置时间" />
                                    <Popup
                                        IsOpen="{Binding TimeDropdownToggleIsChecked, Mode=TwoWay}"
                                        Placement="Bottom"
                                        PlacementTarget="{Binding ElementName=TimeDropdownToggle}"
                                        StaysOpen="False">
                                        <Border
                                            Background="White"
                                            BorderBrush="Gray"
                                            BorderThickness="1">
                                            <ListBox
                                                x:Name="TimeListBox"
                                                MaxHeight="150"
                                                DisplayMemberPath="DisplayName"
                                                ItemsSource="{Binding TimeOptions}"
                                                SelectedItem="{Binding TimeSelected}" />
                                        </Border>
                                    </Popup>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <!--  植物  -->
                        <TabItem Header="植物">
                            <Grid DataContext="{Binding Plants}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="35" />
                                    <RowDefinition Height="35" />
                                    <RowDefinition Height="35" />
                                    <RowDefinition Height="35" />
                                    <RowDefinition Height="35" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="20" />
                                </Grid.ColumnDefinitions>

                                <!--  植物无敌  -->
                                <TextBox
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Width="30"
                                    Height="25"
                                    FontSize="16"
                                    IsReadOnly="True"
                                    Text="{Binding InvincPlant}" />
                                <Button
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Width="90"
                                    Height="25"
                                    Command="{Binding InvincPlantCommand}"
                                    Content="植物无敌" />

                                <!--  只投黄油  -->
                                <TextBox
                                    Grid.Row="0"
                                    Grid.Column="3"
                                    Width="30"
                                    Height="25"
                                    FontSize="16"
                                    IsReadOnly="True"
                                    Text="{Binding OnlyButter}" />
                                <Button
                                    Grid.Row="0"
                                    Grid.Column="4"
                                    Width="90"
                                    Height="25"
                                    Command="{Binding OnlyButterCommand}"
                                    Content="只投黄油" />

                                <!--  植物清醒  -->
                                <TextBox
                                    Grid.Row="0"
                                    Grid.Column="6"
                                    Width="30"
                                    Height="25"
                                    FontSize="16"
                                    IsReadOnly="True"
                                    Text="{Binding WakeUp}" />
                                <Button
                                    Grid.Row="0"
                                    Grid.Column="7"
                                    Width="90"
                                    Height="25"
                                    Command="{Binding WakeUpCommand}"
                                    Content="植物清醒" />

                                <!--  核弹无坑  -->
                                <TextBox
                                    Grid.Row="0"
                                    Grid.Column="9"
                                    Width="30"
                                    Height="25"
                                    FontSize="16"
                                    IsReadOnly="True"
                                    Text="{Binding NoCrater}" />
                                <Button
                                    Grid.Row="0"
                                    Grid.Column="10"
                                    Width="90"
                                    Height="25"
                                    Command="{Binding NoCraterCommand}"
                                    Content="核弹无坑" />

                                <!--  植物血量显示  -->
                                <TextBox
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Width="30"
                                    Height="25"
                                    FontSize="16"
                                    IsReadOnly="True"
                                    Text="{Binding DrawPlantHP}" />
