                                            Background="White"
                                            BorderBrush="Gray"
                                            BorderThickness="1">
                                            <ListBox
                                                x:Name="PlantRowTypeListBox"
                                                MaxHeight="150"
                                                DisplayMemberPath="DisplayName"
                                                ItemsSource="{Binding PlantRowTypeOptions}"
                                                SelectedItem="{Binding SelectedPlantRowType}" />
                                        </Border>
                                    </Popup>
                                    <TextBox
                                        x:Name="GridSquareTogetInput"
                                        Grid.Column="5"
                                        Width="30"
                                        Height="25"
                                        VerticalAlignment="Top"
                                        FontSize="16"
                                        IsReadOnly="True"
                                        Text="{Binding GridSquareTogetInput}" />
                                    <Button
                                        x:Name="GridSquareTogetBtn"
                                        Grid.Column="6"
                                        Height="25"
                                        Command="{Binding ToggleGridSquareTogetCommand}"
                                        Content="同步格子" />
                                </Grid>

                                <!--  格子  -->
                                <Grid Margin="0,65,0,0" VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="25" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="25" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="Formation_Col_Input"
                                        Grid.Column="0"
                                        Height="25"
                                        FontSize="16"
                                        Text="{Binding FormationColInput}" />
                                    <ToggleButton
                                        x:Name="FormationColDropdownToggle"
                                        Grid.Column="1"
                                        Width="25"
                                        Height="25"
                                        Content="🔻"
                                        IsChecked="{Binding FormationColDropdownToggleIsChecked, Mode=TwoWay}" />
                                    <Popup
                                        IsOpen="{Binding FormationColDropdownToggleIsChecked, Mode=TwoWay}"
                                        Placement="Bottom"
                                        PlacementTarget="{Binding ElementName=FormationColDropdownToggle}"
                                        StaysOpen="False">
                                        <Border
                                            Background="White"
                                            BorderBrush="Gray"
                                            BorderThickness="1">
                                            <ListBox
                                                x:Name="FormationColListBox"
                                                MaxHeight="150"
                                                DisplayMemberPath="DisplayName"
                                                ItemsSource="{Binding FormationColOptions}"
                                                SelectedItem="{Binding SelectedFormationCol}" />
                                        </Border>
                                    </Popup>
                                    <TextBox
                                        x:Name="GridSquareTypeInput"
                                        Grid.Column="2"
                                        Height="25"
                                        FontSize="16"
                                        Text="{Binding GridSquareTypeInput}" />
                                    <ToggleButton
                                        x:Name="GridSquareTypeDropdownToggle"
                                        Grid.Column="3"
                                        Height="25"
                                        Content="🔻"
                                        IsChecked="{Binding GridSquareTypeDropdownToggleIsChecked, Mode=TwoWay}" />
                                    <Button
                                        x:Name="GridSquareTypeBtn"
                                        Grid.Column="4"
                                        Height="25"
                                        Command="{Binding GridSquareTypeCommand}"
                                        Content="格子类型" />
                                    <Popup
                                        IsOpen="{Binding GridSquareTypeDropdownToggleIsChecked, Mode=TwoWay}"
                                        Placement="Bottom"
                                        PlacementTarget="{Binding ElementName=GridSquareTypeDropdownToggle}"
                                        StaysOpen="False">
                                        <Border
                                            Background="White"
                                            BorderBrush="Gray"
                                            BorderThickness="1">
                                            <ListBox
                                                x:Name="GridSquareTypeListBox"
                                                MaxHeight="150"
                                                DisplayMemberPath="DisplayName"
                                                ItemsSource="{Binding GridSquareTypeOptions}"
                                                SelectedItem="{Binding SelectedGridSquareType}" />
                                        </Border>
                                    </Popup>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <!--  娱乐  -->
                        <TabItem Header="娱乐">
                            <Grid DataContext="{Binding Fun}">
                                <!--  随机罐子  -->
                                <TextBox
                                    x:Name="RandomVaseInput"
                                    Width="30"
                                    Height="25"
                                    Margin="0,5,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    FontSize="16"
                                    IsReadOnly="True"
                                    Text="{Binding RandomVase}" />
                                <Button
                                    x:Name="RandomVaseBtn"
                                    Width="90"
                                    Height="25"
                                    Margin="30,5,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Command="{Binding RandomVaseCommand}"
                                    Content="随机罐子" />

                                <!--  随机卡片  -->
                                <TextBox
                                    x:Name="RandomCardInput"
                                    Width="30"
                                    Height="25"
                                    Margin="130,5,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    FontSize="16"
                                    IsReadOnly="True"
                                    Text="{Binding RandomCard}" />
                                <Button
                                    x:Name="RandomCardBtn"
                                    Width="90"
                                    Height="25"
                                    Margin="160,5,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Command="{Binding RandomCardCommand}"
                                    Content="随机卡片" />

                                <!--  随机卡槽  -->
                                <TextBox
                                    x:Name="RandomPacketInput"
                                    Width="30"
                                    Height="25"
                                    Margin="260,5,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    FontSize="16"
                                    IsReadOnly="True"
                                    Text="{Binding RandomPacket}" />
                                <Button
                                    x:Name="RandomPacketBtn"
                                    Width="90"
                                    Height="25"
                                    Margin="290,5,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Command="{Binding RandomPacketCommand}"
                                    Content="随机卡槽" />
                            </Grid>
                        </TabItem>
                        <!--  快捷脚本  -->
                        <TabItem Header="快捷脚本">
                            <Grid DataContext="{Binding QMod}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid
                                    Grid.Row="0"
                                    Margin="0,5,0,0"
                                    VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="500" />
                                        <ColumnDefinition Width="25" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="QModInput"
                                        Grid.Column="0"
                                        Width="520"
                                        Height="25"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        FontSize="16"
                                        Text="{Binding QMod}" />
                                    <ToggleButton
                                        x:Name="QModDropdownToggle"
                                        Grid.Column="1"
                                        Width="25"
                                        Height="25"
                                        Content="🔻"
                                        IsChecked="{Binding QModDropdownToggleIsChecked, Mode=TwoWay}" />
                                    <Popup
                                        IsOpen="{Binding QModDropdownToggleIsChecked, Mode=TwoWay}"
                                        Placement="Bottom"
                                        PlacementTarget="{Binding ElementName=QModDropdownToggle}"
                                        StaysOpen="False">
                                        <Border
                                            Background="White"
                                            BorderBrush="Gray"
                                            BorderThickness="1">
                                            <ListBox
                                                x:Name="QModListBox"
                                                MaxHeight="150"
                                                DisplayMemberPath="DisplayName"
                                                ItemsSource="{Binding QModOptions}"
                                                SelectedItem="{Binding QModSelected}" />
                                        </Border>
                                    </Popup>
                                    <Button
                                        x:Name="QModBtn"
                                        Grid.Column="2"
                                        Width="90"
                                        Height="25"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Command="{Binding QModCommand}"
                                        Content="快捷脚本" />
                                </Grid>
                                <Grid
                                    Grid.Row="1"
                                    Margin="0,5,0,0"
                                    VerticalAlignment="Top">
                                    <TextBlock Text="{Binding InfoAll}" />
                                </Grid>
                                <Grid
                                    Grid.Row="2"
                                    Margin="0,5,0,0"
                                    VerticalAlignment="Top">
                                    <TextBlock Text="{Binding DisplayAuthor}" />
                                </Grid>
                                <ScrollViewer Grid.Row="3" Margin="0,10,0,0">
                                    <ItemsControl ItemsSource="{Binding Parameters}">
                                        <ItemsControl.Resources>
                                            <!--  定义两种模板  -->
                                            <DataTemplate x:Key="TextBoxTemplate">
                                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                            </DataTemplate>
                                            <DataTemplate x:Key="ComboBoxTemplate">
                                                <ComboBox
                                                    MinWidth="120"
                                                    HorizontalAlignment="Stretch"
                                                    ItemsSource="{Binding Options}"
                                                    SelectedItem="{Binding Value}" />
                                            </DataTemplate>
                                        </ItemsControl.Resources>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Padding="0,5"
                                                    BorderBrush="LightGray"
                                                    BorderThickness="0,0,0,1">
                                                    <StackPanel>
                                                        <TextBlock
                                                            Margin="0,0,0,3"
                                                            Text="{Binding DisplayDescription}"
                                                            TextWrapping="Wrap"
                                                            ToolTip="{Binding DisplayDescription}" />
                                                        <!--  根据 ControlType 选择模板  -->
                                                        <ContentControl Content="{Binding}">
                                                            <ContentControl.Style>
                                                                <Style TargetType="ContentControl">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ControlType}" Value="TextBox">
                                                                            <Setter Property="ContentTemplate" Value="{StaticResource TextBoxTemplate}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ControlType}" Value="ComboBox">
                                                                            <Setter Property="ContentTemplate" Value="{StaticResource ComboBoxTemplate}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ContentControl.Style>
                                                        </ContentControl>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>

                <!--  底部按钮  -->
                <Grid Grid.Row="3">
                    <Button
                        Name="Btn_UpdateVersion"
                        Width="90"
                        Height="25"
                        Margin="-530,0,0,5"
                        Command="{Binding UpdateVersionCommand}"
                        Content="获取更新" />
                    <Button
                        Width="90"
                        Height="25"
                        Margin="-330,0,0,5"
                        Command="{Binding OpenPathCommand}"
                        Content="打开文件目录" />
                    <Button
                        Width="30"
                        Height="25"
                        Margin="365,0,0,5"
                        Command="{Binding SizeUpCommand}"
                        Content="+" />
                    <Button
                        Width="30"
                        Height="25"
                        Margin="430,0,0,5"
                        Command="{Binding SizeDownCommand}"
                        Content="-" />
                    <TextBlock
                        Name="SizeText"
                        Width="33"
                        Height="15"
                        Margin="300,0,0,5"
                        Text="{Binding SizeText}" />
                    <Button
                        Width="30"
                        Height="25"
                        Margin="495,0,0,5"
                        Command="{Binding SettingCommand}"
                        Content="环境" />
                </Grid>
            </Grid>
        </Border>
    </Viewbox>
</Window>
