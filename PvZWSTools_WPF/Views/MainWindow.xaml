<Window
    x:Class="PvZWSTools_WPF.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PvZWSTools_WPF.Controls"
    xmlns:conv="clr-namespace:PvZWSTools_WPF.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="PvZWSTools_Windows"
    Width="1120"
    Height="720"
    MinWidth="860"
    MinHeight="540"
    Background="{DynamicResource BgRootBrush}"
    FontFamily="Microsoft YaHei UI"
    FontSize="15"
    Icon="../Resources/icon.ico"
    SizeChanged="Window_SizeChanged"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <conv:ConsoleColorConverter x:Key="ConsoleColor" />

        <!--  控制台的"新行来了贴到底"只能写代码（WPF 没有声明式的贴底），所以这个模板留在本文件：
              UnitTemplates.xaml 没有代码后置，挂不了 TextChanged / KeyDown。 -->
        <DataTemplate x:Key="ConsoleTemplate">
            <StackPanel Margin="16,12">
                <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                    <Button
                        Width="110"
                        Command="{Binding Extra.CycleFilterCommand}"
                        Content="{Binding Extra.FilterText}"
                        ToolTip="点击切换：全部 / 只看日志 / 只看收发" />
                    <CheckBox
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Content="自动滚动"
                        IsChecked="{Binding Extra.AutoScroll}" />
                    <CheckBox
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Content="暂停"
                        IsChecked="{Binding Extra.Frozen}"
                        ToolTip="攒住当前画面不再刷新；行照样收着，取消暂停就能看到" />
                    <Button
                        Width="70"
                        Margin="12,0,0,0"
                        Command="{Binding Extra.ClearCommand}"
                        Content="清空" />
                </StackPanel>

                <ScrollViewer
                    x:Name="ConsoleScroll"
                    Height="360"
                    Background="{DynamicResource BgControlBrush}"
                    BorderBrush="{DynamicResource BorderLineBrush}"
                    BorderThickness="1"
                    HorizontalScrollBarVisibility="Auto"
                    Loaded="ConsoleScroll_Loaded"
                    Unloaded="ConsoleScroll_Unloaded"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl FontFamily="Consolas" FontSize="13" ItemsSource="{Binding Extra.Shown}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Foreground="{Binding Color, Converter={StaticResource ConsoleColor}}"
                                    Text="{Binding Text}"
                                    TextWrapping="NoWrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBox
                    x:Name="ConsoleInput"
                    Height="76"
                    Margin="0,8,0,0"
                    AcceptsReturn="True"
                    FontFamily="Consolas"
                    FontSize="13"
                    HorizontalScrollBarVisibility="Auto"
                    Tag="{Binding Extra}"
                    KeyDown="ConsoleInput_KeyDown"
                    Text="{Binding Extra.Input, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="写 Python/IronPython 语句直接发给游戏；Ctrl+Enter 发送"
                    VerticalScrollBarVisibility="Auto" />

                <Button
                    Margin="0,8,0,0"
                    HorizontalAlignment="Left"
                    Command="{Binding Extra.SendCommand}"
                    Content="发送"
                    Style="{DynamicResource AccentButtonStyle}" />
            </StackPanel>
        </DataTemplate>

        <controls:ActiveViewSelector
            x:Key="ActiveViewSelector"
            Console="{StaticResource ConsoleTemplate}"
            Favorites="{StaticResource FavoritesTemplate}"
            Garden="{StaticResource GardenTemplate}"
            Page="{StaticResource PageTemplate}"
            Results="{StaticResource ResultsTemplate}"
            Script="{StaticResource ScriptTemplate}" />
    </Window.Resources>

    <!--  自适应骨架：连接栏 / 导航+内容 / 进度条 / 工具栏。
          不再用 Viewbox 缩放固定画布，字号恒定，窗口多大就排多密。  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  连接栏 + 全局搜索  -->
        <Border
            Grid.Row="0"
            Padding="12,8"
            Background="{DynamicResource BgPanelBrush}"
            BorderBrush="{DynamicResource BorderLineBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBox
                        x:Name="wsAddrInput"
                        Width="340"
                        Height="32"
                        VerticalContentAlignment="Center"
                        FontSize="15"
                        Text="{Binding Root.WsAddress, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Margin="8,0,0,0"
                        Padding="14,4"
                        Command="{Binding Root.ConnectCommand}"
                        Content="{Binding Root.ConnectionButtonText}"
                        Style="{DynamicResource AccentButtonStyle}" />
                </StackPanel>
                <Grid Grid.Column="1" Margin="12,0,0,0">
                    <TextBox
                        x:Name="SearchBox"
                        Height="32"
                        VerticalContentAlignment="Center"
                        FontSize="15"
                        TextChanged="SearchBox_TextChanged"
                        ToolTip="按名称搜索全部功能" />
                    <TextBlock
                        Margin="9,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="15"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        IsHitTestVisible="False"
                        Text="搜索功能…">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <!--  导航 + 内容  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="168" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{DynamicResource BorderLineBrush}"
                BorderThickness="0,0,1,0">
                <ListBox
                    x:Name="NavList"
                    IsSynchronizedWithCurrentItem="False"
                    ItemsSource="{Binding Pages}"
                    SelectedItem="{Binding Selected}"
                    Style="{StaticResource NavListStyle}" />
            </Border>

            <!--  滚动只放在这一层：换页签时能确定地回到顶部，不会把上一页的滚动位置带过去  -->
            <ScrollViewer
                x:Name="PageScroll"
                Grid.Column="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <ContentControl
                    x:Name="MainContent"
                    Content="{Binding ActiveView}"
                    ContentTemplateSelector="{StaticResource ActiveViewSelector}">
                    <ContentControl.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                    </ContentControl.LayoutTransform>
                </ContentControl>
            </ScrollViewer>
        </Grid>

        <!--  更新进度  -->
        <Border
            Grid.Row="2"
            Padding="10,4"
            Background="{DynamicResource BgPanelBrush}"
            BorderBrush="{DynamicResource BorderLineBrush}"
            BorderThickness="0,1,0,0"
            Visibility="{Binding Root.IsUpdating, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        FontSize="14"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="{Binding Root.UpdateStatusText}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock
                            FontSize="14"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="{Binding Root.UpdateDownloadedMB}" />
                        <TextBlock
                            FontSize="14"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text=" / " />
                        <TextBlock
                            FontSize="14"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="{Binding Root.UpdateTotalMB}" />
                        <TextBlock
                            Margin="8,0,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="{Binding Root.UpdateSpeed}" />
                    </StackPanel>
                </Grid>
                <ProgressBar
                    Grid.Row="1"
                    Height="3"
                    Margin="0,5,0,0"
                    Foreground="{DynamicResource AccentBrush}"
                    Maximum="100"
                    Value="{Binding Root.UpdateProgress, Mode=OneWay}" />
            </Grid>
        </Border>

        <!--  工具栏  -->
        <Border
            Grid.Row="3"
            Padding="10,7"
            Background="{DynamicResource BgPanelBrush}"
            BorderBrush="{DynamicResource BorderLineBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button
                        Margin="0,0,8,0"
                        Padding="14,6"
                        Command="{Binding Root.StateManagerCommand}"
                        Content="状态管理" />
                    <Button
                        Margin="0,0,8,0"
                        Padding="14,6"
                        Command="{Binding Root.SettingCommand}"
                        Content="环境" />
                    <Button
                        Margin="0,0,8,0"
                        Padding="14,6"
                        Click="UiButton_Click"
                        Content="UI" />
                    <Button
                        Margin="0,0,8,0"
                        Padding="14,6"
                        Command="{Binding Root.UpdateVersionCommand}"
                        Content="获取更新" />
                    <Button
                        Padding="14,6"
                        Command="{Binding Root.OpenPathCommand}"
                        Content="打开文件目录" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        Width="34"
                        Padding="0,6"
                        Command="{Binding ZoomOutCommand}"
                        Content="−"
                        ToolTip="缩小界面" />
                    <TextBlock
                        Width="46"
                        Margin="6,0"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="{Binding ZoomText}" />
                    <Button
                        Width="34"
                        Padding="0,6"
                        Command="{Binding ZoomInCommand}"
                        Content="+"
                        ToolTip="放大界面" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
