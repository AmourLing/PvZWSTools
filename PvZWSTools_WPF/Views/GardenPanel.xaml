<UserControl
    x:Class="PvZWSTools_WPF.Views.GardenPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:PvZWSTools_WPF.Themes">

    <UserControl.Resources>
        <!--  格位热区：压在背景图上，所以不走主题的按钮样式，只留半透明底板 + 格名。  -->
        <Style x:Key="GardenCellStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Plate"
                            Background="#2E000000"
                            BorderBrush="#8AFFFFFF"
                            BorderThickness="1">
                            <TextBlock
                                Margin="2,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="White"
                                Text="{TemplateBinding Content}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!--  种上了换绿底，一眼看出哪几格是空的。排在悬停之前，鼠标指过来照样盖上去。  -->
                            <DataTrigger Binding="{Binding IsOccupied}" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="#592E7D32" />
                                <Setter TargetName="Plate" Property="BorderBrush" Value="#CC93C7A4" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="#59FFFFFF" />
                                <Setter TargetName="Plate" Property="BorderBrush" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="#8CFFC24D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Button
            Grid.Row="0"
            Margin="0,0,0,8"
            Padding="10,4"
            HorizontalAlignment="Left"
            Command="{Binding ReadGardenCommand}"
            Content="{loc:Loc '读取花园'}"
            ToolTip="{loc:Loc '从游戏读回每一格现在种的是什么；改完也会自动读一次'}" />

        <TabControl
            Grid.Row="1"
            DisplayMemberPath="Header"
            ItemsSource="{Binding Tabs}"
            SelectedIndex="{Binding SelectedTabIndex}">
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <!--  整张 1400x600 的背景原样摆、不裁剪。纵向按可用高度缩放（Pan 的高度由
                          Pan_Loaded 现算，不这么干的话 Viewbox 会拿到无限高度、整页被撑出
                          纵向滚动条，换页签还得先滚回顶部），横向放不下就滚动条 + 滚轮，
                          初始位置按格子的中心算。  -->
                    <ScrollViewer
                        x:Name="Pan"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled"
                        Loaded="Pan_Loaded"
                        PreviewMouseWheel="Pan_PreviewMouseWheel">
                        <Viewbox HorizontalAlignment="Center">
                            <Grid
                                Width="{Binding CanvasWidth}"
                                Height="{Binding CanvasHeight}">
                                <Image Source="{Binding Backdrop}" Stretch="None" />
                                <ItemsControl ItemsSource="{Binding Cells}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                            <Setter Property="Width" Value="{Binding W}" />
                                            <Setter Property="Height" Value="{Binding H}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button
                                                Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.GardenButtonCommand}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding Caption}"
                                                Style="{StaticResource GardenCellStyle}"
                                                ToolTip="{Binding Tip}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Viewbox>
                    </ScrollViewer>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </Grid>
</UserControl>
