<Window
    x:Class="PvZWSTools_WPF.Views.WaveJsonEditor"
    Background="{DynamicResource BgRootBrush}"
    FontFamily="Microsoft YaHei UI"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="编辑波次出怪 JSON"
    Width="620"
    Height="520"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,8"
            FontSize="13"
            Text="每波一行 waveN，方括号里是 [僵尸序号, 数量]。「载入到游戏」写回关卡；「仅保存」只留在这台设备上，进关后用『载入已存波次表』灌回去。"
            TextWrapping="Wrap" />

        <TextBox
            Grid.Row="1"
            AcceptsReturn="True"
            AcceptsTab="True"
            Background="{DynamicResource BgControlBrush}"
            BorderBrush="{DynamicResource BorderLineBrush}"
            FontFamily="Consolas"
            FontSize="14"
            HorizontalScrollBarVisibility="Auto"
            Text="{Binding Json, UpdateSourceTrigger=PropertyChanged}"
            TextWrapping="NoWrap"
            VerticalScrollBarVisibility="Auto" />

        <TextBlock
            Grid.Row="2"
            Margin="0,8,0,0"
            FontSize="12"
            Foreground="{DynamicResource DangerBrush}"
            Text="{Binding Error}"
            TextWrapping="Wrap" />

        <StackPanel
            Grid.Row="3"
            Margin="0,10,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="100"
                Height="28"
                Margin="0,0,10,0"
                Command="{Binding ApplyCommand}"
                Content="载入到游戏"
                IsDefault="True" />
            <Button
                Width="90"
                Height="28"
                Margin="0,0,10,0"
                Command="{Binding SaveOnlyCommand}"
                Content="仅保存" />
            <Button
                Width="70"
                Height="28"
                Command="{Binding CancelCommand}"
                Content="取消"
                IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
