<Window
    x:Class="PvZWSTools_WPF.Views.SettingDialog"
    Background="{DynamicResource BgRootBrush}"
    FontFamily="Microsoft YaHei UI"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:PvZWSTools_WPF.Themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:PvZWSTools_Shared.ViewModels"
    Title="{loc:Loc 设置}"
    Width="300"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ItemsControl Grid.Row="0" ItemsSource="{Binding Settings}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <CheckBox
                        Margin="0,6,0,0"
                        Content="{Binding Label}"
                        FontSize="16"
                        IsChecked="{Binding Value}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel
            Grid.Row="1"
            Margin="0,15,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="70"
                Height="28"
                Margin="0,0,10,0"
                Command="{Binding OkCommand}"
                Content="{loc:Loc 确定}"
                FontSize="14" />
            <Button
                Width="70"
                Height="28"
                Command="{Binding CancelCommand}"
                Content="{loc:Loc 取消}"
                FontSize="14" />
        </StackPanel>
    </Grid>
</Window>
