<Window
    x:Class="PvZWSTools_WPF.Views.UpdateWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="检查更新"
    Width="480"
    Height="560"
    ResizeMode="CanResize"
    MinWidth="400"
    MinHeight="480"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 当前版本 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock FontSize="11" Foreground="#888" Text="当前版本" />
            <TextBlock FontSize="20" FontWeight="Bold" Text="{Binding CurrentVersionDisplay}" />
        </StackPanel>

        <!-- 检查按钮 / 状态 -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <Button
                x:Name="CheckButton"
                Height="32"
                Click="CheckButton_Click"
                Content="检查更新" />
            <TextBlock
                Margin="0,8,0,0"
                Foreground="#666"
                Text="{Binding StatusText}" />
        </StackPanel>

        <!-- 发现新版本区域（默认隐藏） -->
        <StackPanel Grid.Row="2" Margin="0,0,0,8" Visibility="{Binding UpdateFoundVisibility}">
            <Separator Margin="0,4,0,8" />
            <TextBlock FontSize="14" FontWeight="Bold" Foreground="#2E7D32" Text="发现新版本！" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock FontSize="15" FontWeight="Bold" Text="{Binding NewVersionTagName}" />
                <TextBlock Margin="12,0,0,0" Foreground="#888" Text="{Binding UpdateSizeText}" />
            </StackPanel>

            <!-- 更新渠道选择 -->
            <TextBlock Margin="0,8,0,4" FontSize="12" Foreground="#555" Text="下载渠道：" />
            <StackPanel>
                <RadioButton
                    Content="GitHub （海外高速，国内可能较慢）"
                    IsChecked="{Binding SourceIsGithub}"
                    IsEnabled="{Binding HasGithub}" />
                <RadioButton
                    Content="Gitee （国内高速，推荐）"
                    Margin="0,2,0,0"
                    IsChecked="{Binding SourceIsGitee}"
                    IsEnabled="{Binding HasGitee}" />
                <RadioButton
                    Content="百度网盘 （国内备用，需提取码）"
                    Margin="0,2,0,0"
                    IsChecked="{Binding SourceIsBaidu}"
                    IsEnabled="{Binding HasBaidu}" />
            </StackPanel>
        </StackPanel>

        <!-- 更新说明 -->
        <GroupBox
            Grid.Row="3"
            Margin="0,0,0,8"
            Header="更新说明"
            Visibility="{Binding UpdateFoundVisibility}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock
                    Text="{Binding UpdateInfo.ReleaseNotes}"
                    TextWrapping="Wrap"
                    TextBlock.LineHeight="20"
                    Foreground="#333" />
            </ScrollViewer>
        </GroupBox>

        <!-- 下载进度 / 底部按钮 -->
        <Grid Grid.Row="4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button
                    Height="32"
                    Width="80"
                    Margin="0,0,8,0"
                    Content="关闭"
                    Click="CloseButton_Click" />
                <Button
                    x:Name="DownloadButton"
                    Height="32"
                    Width="120"
                    Content="下载并更新"
                    IsEnabled="{Binding CanDownload}"
                    Click="DownloadButton_Click" />
            </StackPanel>

            <!-- 下载进度（默认隐藏） -->
            <StackPanel
                Margin="0,0,0,0"
                Visibility="{Binding DownloadProgressVisibility}">
                <TextBlock Text="{Binding DownloadStatusText}" FontSize="12" Foreground="#333" />
                <ProgressBar
                    Margin="0,4,0,4"
                    Height="16"
                    Value="{Binding DownloadProgress}"
                    Minimum="0"
                    Maximum="100" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="11" Foreground="#666">
                        <Run Text="{Binding DownloadedMB}" />
                        <Run Text=" / " />
                        <Run Text="{Binding TotalMB}" />
                    </TextBlock>
                    <TextBlock
                        Margin="8,0,0,0"
                        FontSize="11"
                        Foreground="#666"
                        Text="{Binding DownloadSpeed}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
