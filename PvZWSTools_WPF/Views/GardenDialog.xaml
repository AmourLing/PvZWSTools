<Window
    x:Class="PvZWSTools_WPF.Views.GardenDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:PvZWSTools_WPF.ViewModels"
    Title="花园编辑"
    Width="300"
    Height="450"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="60" />
            <RowDefinition Height="60" />
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  位置提示  -->
        <TextBlock
            Name="NowState"
            Grid.Row="0"
            Height="25"
            FontSize="16"
            Text="{Binding LocationText}" />

        <!--  植物类型  -->
        <Grid Grid.Row="1">
            <TextBlock FontSize="16" Text="植物类型" />
            <Grid
                Margin="0,25,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="25" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="SeedTypeInput"
                    Grid.Column="0"
                    Height="25"
                    VerticalAlignment="Top"
                    FontSize="16"
                    IsReadOnly="True"
                    Text="{Binding SelectedSeedTypeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ToggleButton
                    x:Name="SeedTypeDropdownToggle"
                    Grid.Column="1"
                    Width="25"
                    Height="25"
                    VerticalAlignment="Top"
                    Content="🔻"
                    IsChecked="{Binding SeedTypeDropdownOpen, Mode=TwoWay}" />
                <Popup
                    IsOpen="{Binding SeedTypeDropdownOpen}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=SeedTypeDropdownToggle}"
                    StaysOpen="False">
                    <Border
                        Background="White"
                        BorderBrush="Gray"
                        BorderThickness="1">
                        <ListBox
                            x:Name="SeedTypeListBox"
                            MaxHeight="150"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding SeedTypeOptions}"
                            SelectedItem="{Binding SelectedSeedTypeOption}" />
                    </Border>
                </Popup>
            </Grid>
        </Grid>

        <!--  植物朝向  -->
        <Grid Grid.Row="2">
            <TextBlock FontSize="16" Text="植物朝向" />
            <Grid
                Margin="0,25,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="25" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="FacingInput"
                    Grid.Column="0"
                    Height="25"
                    VerticalAlignment="Top"
                    FontSize="16"
                    IsReadOnly="True"
                    Text="{Binding SelectedFacingDisplay, Mode=TwoWay}" />
                <ToggleButton
                    x:Name="FacingDropdownToggle"
                    Grid.Column="1"
                    Width="25"
                    Height="25"
                    VerticalAlignment="Top"
                    Content="🔻"
                    IsChecked="{Binding FacingDropdownOpen, Mode=TwoWay}" />
                <Popup
                    IsOpen="{Binding FacingDropdownOpen}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=FacingDropdownToggle}"
                    StaysOpen="False">
                    <Border
                        Background="White"
                        BorderBrush="Gray"
                        BorderThickness="1">
                        <ListBox
                            x:Name="FacingListBox"
                            MaxHeight="150"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding FacingOptions}"
                            SelectedItem="{Binding SelectedFacingOption}" />
                    </Border>
                </Popup>
            </Grid>
        </Grid>

        <!--  植物年龄  -->
        <Grid Grid.Row="3">
            <TextBlock FontSize="16" Text="植物年龄" />
            <Grid
                Margin="0,25,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="25" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="AgeInput"
                    Grid.Column="0"
                    Height="25"
                    VerticalAlignment="Top"
                    FontSize="16"
                    IsReadOnly="True"
                    Text="{Binding SelectedAgeDisplay, Mode=TwoWay}" />
                <ToggleButton
                    x:Name="AgeDropdownToggle"
                    Grid.Column="1"
                    Width="25"
                    Height="25"
                    VerticalAlignment="Top"
                    Content="🔻"
                    IsChecked="{Binding AgeDropdownOpen, Mode=TwoWay}" />
                <Popup
                    IsOpen="{Binding AgeDropdownOpen}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=AgeDropdownToggle}"
                    StaysOpen="False">
                    <Border
                        Background="White"
                        BorderBrush="Gray"
                        BorderThickness="1">
                        <ListBox
                            x:Name="AgeListBox"
                            MaxHeight="150"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding AgeOptions}"
                            SelectedItem="{Binding SelectedAgeOption}" />
                    </Border>
                </Popup>
            </Grid>
        </Grid>

        <Grid Grid.Row="4">
            <!--  空白填充  -->
        </Grid>

        <!--  确定/取消按钮  -->
        <Grid Grid.Row="5">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    MinWidth="60"
                    Margin="0,0,10,0"
                    Command="{Binding OkCommand}"
                    Content="确定"
                    IsDefault="True" />
                <Button
                    MinWidth="60"
                    Command="{Binding CancelCommand}"
                    Content="取消"
                    IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
