<Window
    x:Class="PvZWSTools_WPF.Views.StateWindow"
    Background="{DynamicResource BgRootBrush}"
    FontFamily="Microsoft YaHei UI"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="状态管理"
    Width="500"
    Height="540"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Viewbox Stretch="Fill">
        <Border Width="500" Height="540">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  顶部说明  -->
                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,8"
                    FontSize="16"
                    TextWrapping="Wrap"
                    Text="保存/恢复各页签的开关、输入框、下拉框状态。首项“上次状态”为关闭时自动保存，不可删除；选中任意条目点“加载”即可恢复。" />

                <!--  主内容区：上方预设列表 + 下方详细信息面板  -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  预设列表  -->
                    <Border
                        Grid.Row="0"
                        BorderBrush="{DynamicResource BorderLineBrush}"
                        BorderThickness="1">
                        <ListBox
                            Name="PresetList"
                            ItemsSource="{Binding PresetNames}"
                            SelectedIndex="{Binding SelectedPresetIndex}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="16" Text="{Binding}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!--  详细信息面板  -->
                    <Border
                        Grid.Row="1"
                        Height="220"
                        Margin="0,8,0,0"
                        Background="{DynamicResource BgPanelBrush}"
                        BorderBrush="{DynamicResource BorderLineBrush}"
                        BorderThickness="1"
                        Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Grid.Row="0"
                                Margin="6,4,0,4"
                                FontSize="16"
                                FontWeight="Bold"
                                Text="详细信息（与默认状态对比，★ = 开启的开关）" />
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl
                                    Margin="6,0,6,4"
                                    ItemsSource="{Binding DetailLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                FontSize="16"
                                                Text="{Binding}"
                                                TextWrapping="NoWrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!--  底部操作区：第一行保存输入，第二行操作按钮  -->
                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <!--  第一行：保存输入区  -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="16"
                            Text="名称:" />
                        <TextBox
                            Name="NameInput"
                            Width="180"
                            Margin="5,0,0,0"
                            VerticalContentAlignment="Center"
                            FontSize="16"
                            Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Width="90"
                            Margin="5,0,0,0"
                            Command="{Binding SavePresetCommand}"
                            Content="保存当前"
                            FontSize="16" />
                    </StackPanel>

                    <!--  第二行：操作按钮  -->
                    <StackPanel
                        Margin="0,8,0,0"
                        Orientation="Horizontal">
                        <Button
                            Width="70"
                            Margin="0,0,5,0"
                            Command="{Binding LoadPresetCommand}"
                            Content="加载"
                            FontSize="16" />
                        <Button
                            Width="90"
                            Margin="0,0,5,0"
                            Command="{Binding ShowDetailsCommand}"
                            Content="详细信息"
                            FontSize="16" />
                        <Button
                            Width="70"
                            Margin="0,0,5,0"
                            Command="{Binding DeletePresetCommand}"
                            Content="删除"
                            FontSize="16" />
                        <Button
                            Width="70"
                            Margin="0,0,5,0"
                            Click="CloseButton_Click"
                            Content="关闭"
                            FontSize="16" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Viewbox>
</Window>
