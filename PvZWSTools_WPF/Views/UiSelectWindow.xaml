<Window
    x:Class="PvZWSTools_WPF.Views.UiSelectWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:PvZWSTools_WPF.Themes"
    Title="{loc:Loc 'UI 选择'}"
    Width="300"
    Height="316"
    Background="{DynamicResource BgRootBrush}"
    Foreground="{DynamicResource TextPrimaryBrush}"
    FontFamily="Microsoft YaHei UI"
    FontSize="13"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">

    <StackPanel Margin="16">
        <TextBlock
            FontWeight="Bold"
            Text="{loc:Loc UI 风格}" />
        <RadioButton
            x:Name="RbClassic"
            GroupName="ui"
            Margin="4,6,0,2"
            Content="经典 UI" />
        <RadioButton
            x:Name="RbNewUi"
            GroupName="ui"
            Margin="4,2,0,0"
            Content="NewUI"
            IsChecked="True" />

        <TextBlock
            Margin="0,14,0,0"
            FontWeight="Bold"
            Text="{loc:Loc 主题（仅 NewUI 生效）}" />
        <RadioButton
            x:Name="RbDark"
            GroupName="theme"
            Margin="4,6,0,2"
            Content="{loc:Loc 黑夜}"
            IsChecked="True" />
        <RadioButton
            x:Name="RbLight"
            GroupName="theme"
            Margin="4,2,0,0"
            Content="{loc:Loc 白天}" />

        <!--  语种名故意不翻：这一组是切语言的入口，两种语言下都各自显示本名，才不会找不到自己。  -->
        <TextBlock
            Margin="0,14,0,0"
            FontWeight="Bold"
            Text="{loc:Loc 界面语言}" />
        <RadioButton
            x:Name="RbZh"
            GroupName="lang"
            Margin="4,6,0,2"
            Content="简体中文"
            IsChecked="True" />
        <RadioButton
            x:Name="RbEn"
            GroupName="lang"
            Margin="4,2,0,0"
            Content="English" />

        <StackPanel
            Margin="0,18,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="72"
                Click="Apply_Click"
                Content="{loc:Loc 应用}" />
            <Button
                Width="72"
                Margin="10,0,0,0"
                Click="Close_Click"
                Content="{loc:Loc 关闭, Ctx=btn}" />
        </StackPanel>
    </StackPanel>
</Window>
