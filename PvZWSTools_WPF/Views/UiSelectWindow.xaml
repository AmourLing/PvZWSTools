<Window
    x:Class="PvZWSTools_WPF.Views.UiSelectWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="UI 选择"
    Width="300"
    Height="252"
    Background="{DynamicResource BgRootBrush}"
    Foreground="{DynamicResource TextPrimaryBrush}"
    FontFamily="Microsoft YaHei UI"
    FontSize="13"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">

    <StackPanel Margin="16">
        <TextBlock
            FontWeight="Bold"
            Text="UI 风格" />
        <RadioButton
            x:Name="RbClassic"
            Margin="4,6,0,2"
            Content="经典 UI" />
        <RadioButton
            x:Name="RbNewUi"
            Margin="4,2,0,0"
            Content="NewUI"
            IsChecked="True" />

        <TextBlock
            Margin="0,14,0,0"
            FontWeight="Bold"
            Text="主题（仅 NewUI 生效）" />
        <RadioButton
            x:Name="RbDark"
            Margin="4,6,0,2"
            Content="黑夜"
            IsChecked="True" />
        <RadioButton
            x:Name="RbLight"
            Margin="4,2,0,0"
            Content="白天" />

        <StackPanel
            Margin="0,18,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="72"
                Click="Apply_Click"
                Content="应用" />
            <Button
                Width="72"
                Margin="10,0,0,0"
                Click="Close_Click"
                Content="关闭" />
        </StackPanel>
    </StackPanel>
</Window>
