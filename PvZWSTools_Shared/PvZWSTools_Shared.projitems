  </ItemGroup>
  <ItemGroup>
    <!-- 内嵌脚本：编进程序集，不落 配置文件\，见 Scripts\README.md -->
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)Scripts\GardenChangeText.py" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)Scripts\GardenClearText.py" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)Scripts\GardenQueryText.py" />
    <None Include="$(MSBuildThisFileDirectory)PvZWSTools_Shared.projitems" />
