    <Compile Include="$(MSBuildThisFileDirectory)ViewModels\LevelViewModel.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ViewModels\MainWindowViewModel.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ViewModels\OthersViewModel.cs" />
