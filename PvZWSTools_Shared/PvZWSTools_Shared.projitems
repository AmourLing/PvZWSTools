<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects Condition="'$(MSBuildVersion)' == '' Or '$(MSBuildVersion)' &lt; '16.0'">$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>b98f5710-197f-420e-82eb-5a7750239ceb</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>PvZWSTools_Shared</Import_RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Helpers\Sharedstring.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Models\WSEvents.cs" />
  </ItemGroup>
  <!--
    以下业务共享代码（ViewModels/Helpers/Services/Models/Commands/Platform）
    编译到 WPF 与 Android 两个宿主；同一份源码里用 #if ANDROID 分平台，
    也因为是共享工程，internal 在两边都算同程序集，能直接互相引用。
  -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Commands\RelayCommand.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Helpers\ButtonHelper.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Helpers\CompileTime.cs" />
