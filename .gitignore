# ── 构建产物 ──
[Bb]in/
[Oo]bj/
.fake/
PvZWSTools_WPF/Output/
# 手动双击 installer/PvZWSTools_setup.iss 时，ISCC 把产物写在脚本旁边
/Output/
/installer/Output/

# ── 发布产物：走 GitHub Release 附件，不进仓库历史 ──
publish/
*.exe
*.zip
*.keystore
# 手册 PDF 由 文档/_build/gen_manual.py 生成
文档/**/*.pdf
# 更新器运行时在 exe 旁下载的临时目录
update/

# ── IDE / 编辑器本地状态 ──
.vs/
.vscode/
.workbuddy/
*.user
# 发布配置不入库（*.pubxml 里带本机路径与账号）
*.pubxml

# ── 本机发布脚本与 SDK 锁定，不入库 ──
build-release.ps1
build-release.cmd
global.json

# ── Python / IronPython 本地环境 ──
# typings 源在 IronPythonEditor\typings\，VS Python 项目用 copytypings.bat 镜像一份
IronPythonEditor/
PythonApplication1/
typings/
copytypings.bat
pyrightconfig.json
button_states.json
__pycache__/

# ── 临时/本地项目，不提交 ──
UpdateTest/
VersionTest/
SkillVerify/
.git_backup_*/
