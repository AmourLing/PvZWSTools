# ── 构建产物 ──
[Bb]in/
[Oo]bj/
.fake/
PvZWSTools_WPF/Output/
# 手动双击 installer/PvZWSTools_setup.iss 时，ISCC 把产物写在脚本旁边
/Output/
/installer/Output/

# ── 发布产物：走 GitHub Release 附件，不进仓库历史 ──
publish/
*.exe
*.zip
*.keystore
# 手册 PDF 由 文档/_build/gen_manual.py 生成
文档/**/*.pdf
# 可变字体定到 400 字重的中间产物（单个 10~15 MB，每次构建可复用，不该入库）
文档/_build/fonts/
# 更新器运行时在 exe 旁下载的临时目录
update/

# ── IDE / 编辑器本地状态 ──
.vs/
.vscode/
.workbuddy/
*.user
# 发布配置不入库（*.pubxml 里带本机路径与账号）
*.pubxml

# ── 本机发布脚本与 SDK 锁定，不入库 ──
build-release.ps1
build-release.cmd
global.json

# ── Python / IronPython 本地环境 ──
# typings 源在 IronPythonEditor\typings\，VS Python 项目用 copytypings.bat 镜像一份
IronPythonEditor/
PythonApplication1/
typings/
copytypings.bat
pyrightconfig.json
button_states.json
__pycache__/

# ── 临时/本地项目，不提交 ──
UpdateTest/
VersionTest/
ScriptVerifyHost/
.git_backup_*/

# ── 只在本机用的开发/发布工具，不进公开仓库 ──
# UI核对：清单回归门（读的是本地基准快照，公开仓库里没有对应产物）
# installer：Inno Setup 脚本与它的本地产物
/UI核对/
/installer/

# ── 第三方版权素材：不入库，也不进发布 ──
# 花园四张背景是从游戏 Content/images 的 xnb 解包转出来的，著作权在 PopCap/EA，
# 本仓库的 MIT 无权授予它们。留盘只为本地 -p:HasGarden=true 时能预览；
# csproj 的 Resource 项是通配且默认 HasGarden=false，所以发布包本来也不含它们。
PvZWSTools_WPF/Resources/garden/
