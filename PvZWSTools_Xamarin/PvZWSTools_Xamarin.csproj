    <WriteLinesToFile File="$(BuildInfoFile)" Lines="using System%3B%0anamespace PvZWSTools_Xamarin.Helpers%0a{%0a    public static class BuildInfo%0a    {%0a        public const string CompileTime = &quot;$(BuildTime)&quot;%3B%0a    }%0a}" Overwrite="true" Encoding="UTF-8" />
    <ItemGroup>
