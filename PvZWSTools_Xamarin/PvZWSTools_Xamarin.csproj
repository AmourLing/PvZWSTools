  <Target Name="CreateResourcesZip" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <ConfigPath>$(SolutionDir)配置文件</ConfigPath>
      <ResourcesZip>$(ProjectDir)Assets\need.zip</ResourcesZip>
    </PropertyGroup>
    <Error Condition="!Exists('$(ConfigPath)')" Text="错误: 配置文件目录不存在: $(ConfigPath)" />
    <Exec Condition="'$(OS)' == 'Windows_NT' And Exists('$(ConfigPath)')" Command="powershell -NoProfile -ExecutionPolicy Unrestricted -Command &quot;&amp; { $ErrorActionPreference = 'Stop'; if (Test-Path '$(ResourcesZip)') { Remove-Item '$(ResourcesZip)' -Force }; Compress-Archive -Path '$(ConfigPath)\*' -DestinationPath '$(ResourcesZip)' -CompressionLevel Optimal -Force }&quot;" IgnoreExitCode="false" />
  </Target>
  <ItemGroup>
    <AndroidAsset Include="Assets\need.zip" />
  </ItemGroup>
  <Target Name="GenerateBuildInfo" BeforeTargets="BeforeBuild">
