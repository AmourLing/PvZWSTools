<?xml version="1.0" encoding="utf-8"?>
<Project>
    <PropertyGroup>
        <Configuration>Release</Configuration>
        <Platform>Any CPU</Platform>
        <TargetFramework>net10.0-android</TargetFramework>
        <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <PublishProtocol>FileSystem</PublishProtocol>
        <_TargetId>Folder</_TargetId>
        <PublishDir>bin\Release\net10.0-android\publish\</PublishDir>
        <AndroidSupportedAbis>arm64-v8a</AndroidSupportedAbis>
        <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
        <AndroidUseAssemblyStore>true</AndroidUseAssemblyStore>
        <AndroidKeyStore>false</AndroidKeyStore>
        <LastUsedPlatform>Any CPU</LastUsedPlatform>
        <LastUsedRuntimeIdentifier>android-arm64</LastUsedRuntimeIdentifier>
        <PublishSingleFile>false</PublishSingleFile>
        <CopyApkToPublishDirectory>true</CopyApkToPublishDirectory>
    </PropertyGroup>
</Project>
