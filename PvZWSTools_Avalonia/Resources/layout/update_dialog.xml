<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 当前版本 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="当前版本"
        android:textSize="12sp"
        android:textColor="#888888" />

    <TextView
        android:id="@+id/current_version_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginTop="2dp" />

    <!-- 发现新版本提示 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="发现新版本！"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#2E7D32"
        android:layout_marginTop="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/new_version_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333" />

        <TextView
            android:id="@+id/new_version_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <!-- 渠道选择 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="下载渠道："
        android:textSize="12sp"
        android:textColor="#555555"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp" />

    <RadioGroup
        android:id="@+id/source_radio_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/radio_github"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GitHub（海外高速，国内可能较慢）"
            android:textSize="13sp"
            android:enabled="false" />

        <RadioButton
            android:id="@+id/radio_gitee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gitee（国内高速，推荐）"
            android:textSize="13sp"
            android:layout_marginTop="2dp"
            android:enabled="false" />

        <RadioButton
            android:id="@+id/radio_baidu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="百度网盘（国内备用，需提取码）"
            android:textSize="13sp"
            android:layout_marginTop="2dp"
            android:enabled="false" />
    </RadioGroup>

    <!-- 分割线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#DDDDDD"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp" />

    <!-- 更新说明 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="更新说明"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#555555" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="200dp"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/release_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#333333"
            android:lineSpacingExtra="4dp" />
    </ScrollView>

</LinearLayout>
